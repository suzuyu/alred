{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alred:v1:route-diff-source-map",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "alred/v1"
    },
    "kind": {
      "const": "RouteDiffSourceMap"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "before": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "input_format": {
                      "enum": [
                        "nxos-transcript",
                        "nxos-route-text"
                      ]
                    },
                    "command_id": {
                      "enum": [
                        "route_ipv4_all_vrfs",
                        "route_ipv4_default_vrf",
                        "route_ipv4_vrf",
                        "route_ipv6_all_vrfs",
                        "route_ipv6_default_vrf",
                        "route_ipv6_vrf"
                      ]
                    },
                    "start_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "completeness": {
                      "enum": [
                        "asserted"
                      ]
                    },
                    "vrf": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.-]+$",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "path",
                    "input_format"
                  ],
                  "additionalProperties": false,
                  "dependentRequired": {
                    "start_line": [
                      "end_line"
                    ],
                    "end_line": [
                      "start_line"
                    ]
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "input_format": {
                            "const": "nxos-route-text"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "command_id"
                        ]
                      }
                    },
                    {
                      "if": {
                        "required": [
                          "completeness"
                        ]
                      },
                      "then": {
                        "properties": {
                          "input_format": {
                            "const": "nxos-route-text"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "required": [
                          "command_id"
                        ],
                        "properties": {
                          "command_id": {
                            "enum": [
                              "route_ipv4_vrf",
                              "route_ipv6_vrf"
                            ]
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "vrf"
                        ]
                      },
                      "else": {
                        "not": {
                          "required": [
                            "vrf"
                          ]
                        }
                      }
                    }
                  ]
                },
                "minItems": 1
              },
              "after": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "input_format": {
                      "enum": [
                        "nxos-transcript",
                        "nxos-route-text"
                      ]
                    },
                    "command_id": {
                      "enum": [
                        "route_ipv4_all_vrfs",
                        "route_ipv4_default_vrf",
                        "route_ipv4_vrf",
                        "route_ipv6_all_vrfs",
                        "route_ipv6_default_vrf",
                        "route_ipv6_vrf"
                      ]
                    },
                    "start_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "completeness": {
                      "enum": [
                        "asserted"
                      ]
                    },
                    "vrf": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.-]+$",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "path",
                    "input_format"
                  ],
                  "additionalProperties": false,
                  "dependentRequired": {
                    "start_line": [
                      "end_line"
                    ],
                    "end_line": [
                      "start_line"
                    ]
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "input_format": {
                            "const": "nxos-route-text"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "command_id"
                        ]
                      }
                    },
                    {
                      "if": {
                        "required": [
                          "completeness"
                        ]
                      },
                      "then": {
                        "properties": {
                          "input_format": {
                            "const": "nxos-route-text"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "required": [
                          "command_id"
                        ],
                        "properties": {
                          "command_id": {
                            "enum": [
                              "route_ipv4_vrf",
                              "route_ipv6_vrf"
                            ]
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "vrf"
                        ]
                      },
                      "else": {
                        "not": {
                          "required": [
                            "vrf"
                          ]
                        }
                      }
                    }
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "host",
              "before",
              "after"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "hosts"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "api_version",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "$defs": {
    "ExpectedPath": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "ip",
            "discard",
            "connected",
            "local"
          ]
        },
        "next_hop_family": {
          "anyOf": [
            {
              "enum": [
                "ipv4",
                "ipv6"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "address": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "interface": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "next_hop_vrf": {
          "type": "string",
          "minLength": 1
        },
        "admin_distance": {
          "type": "integer",
          "minimum": 0
        },
        "metric": {
          "type": "integer",
          "minimum": 0
        }
