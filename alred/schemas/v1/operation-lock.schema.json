{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alred.local/schemas/v1/operation-lock.schema.json",
  "title": "OperationLock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "operation",
    "pid",
    "hostname",
    "os_user",
    "started_at",
    "tool_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "hostname": {
      "type": "string",
      "minLength": 1
    },
    "os_user": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    }
  }
}
