{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alred.local/schemas/v1/overlay-preparation-attempt.schema.json",
  "title": "OverlayPreparationAttempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_id", "attempt_id", "status", "started_at", "artifact_dir"],
  "properties": {
    "schema_version": {"const": 1},
    "change_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["RUNNING", "PASS", "FAILED"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "artifact_dir": {"type": "string", "minLength": 1},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
