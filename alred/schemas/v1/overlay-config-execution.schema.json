{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alred.local/schemas/v1/overlay-config-execution.schema.json",
  "title": "OverlayConfigExecution",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec", "status"],
  "properties": {
    "api_version": {"const": "alred/v1"},
    "kind": {"const": "OverlayConfigExecution"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_id", "mode", "started_at", "completed_at", "timezone"],
      "properties": {
        "change_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["apply", "rollback"]},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string", "minLength": 1}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_plan_sha256",
        "rollback_plan_sha256",
        "approval_id",
        "serial",
        "stop_on_first_error",
        "automatic_retry"
      ],
      "properties": {
        "execution_plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "rollback_plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "approval_id": {"type": "string", "minLength": 1},
        "serial": {"const": 1},
        "stop_on_first_error": {"const": true},
        "automatic_retry": {"const": false}
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "devices", "first_failure"],
      "properties": {
        "result": {
          "enum": [
            "APPLY_FAILED",
            "DEVICE_STATE_UNKNOWN",
            "APPLIED_PENDING_HEALTH",
            "APPLIED_AND_VERIFIED",
            "HEALTH_CHECK_FAILED",
            "SAVE_FAILED",
            "ROLLBACK_FAILED",
            "ROLLED_BACK_PENDING_HEALTH",
            "ROLLED_BACK_AND_VERIFIED",
            "ROLLBACK_HEALTH_FAILED"
          ]
        },
        "devices": {
          "type": "object",
          "maxProperties": 50,
          "additionalProperties": {"$ref": "#/$defs/device"}
        },
        "first_failure": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["host", "stage", "message"],
              "properties": {
                "host": {"type": "string", "minLength": 1},
                "stage": {"enum": ["connect", "command", "save", "health"]},
                "command_index": {"type": "integer", "minimum": 1},
                "message": {"type": "string"}
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "command", "started_at", "completed_at", "status", "response", "error"],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "command": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["SUCCESS", "FAILED", "UNKNOWN", "NOT_STARTED"]},
        "response": {"type": "string"},
        "error": {"type": ["string", "null"]}
      }
    },
    "save": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "started_at", "completed_at", "status", "response", "error"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["SUCCESS", "FAILED", "UNKNOWN", "SKIPPED"]},
        "response": {"type": "string"},
        "error": {"type": ["string", "null"]}
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "config_path", "config_sha256", "commands", "save"],
      "properties": {
        "status": {"enum": ["SUCCESS", "FAILED", "UNKNOWN", "NOT_STARTED", "NO_CHANGE"]},
        "config_path": {"type": "string"},
        "config_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}},
        "save": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/save"}
          ]
        },
        "pre_apply_diff": {"type": ["string", "null"]}
      }
    }
  }
}
