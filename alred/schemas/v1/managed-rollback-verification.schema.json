{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alred.local/schemas/v1/managed-rollback-verification.schema.json",
  "title": "ManagedRollbackVerification",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "status", "devices", "artifacts"],
  "properties": {
    "api_version": {"const": "alred/v1"},
    "kind": {"const": "ManagedRollbackVerification"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_id", "verified_at", "timezone"],
      "properties": {
        "change_id": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string", "minLength": 1}
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "health_result", "raw_config_equal", "semantic_config_equal"],
      "properties": {
        "result": {"enum": ["ROLLED_BACK_AND_VERIFIED", "ROLLBACK_HEALTH_FAILED"]},
        "health_result": {"type": "string"},
        "snapshot_fresh": {"type": "boolean"},
        "raw_config_equal": {"type": "boolean"},
        "semantic_config_equal": {"type": "boolean"}
      }
    },
    "devices": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}},
    "artifacts": {"type": "object"}
  }
}
