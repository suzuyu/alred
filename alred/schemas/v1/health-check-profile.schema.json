{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alred.local/schemas/v1/health-check-profile.schema.json",
  "title": "HealthCheckProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "alred/v1"},
    "kind": {"const": "HealthCheckProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms"],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "command_sets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "collectors": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/collector"}
        },
        "auto_features": {
          "oneOf": [
            {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            {
              "type": "object",
              "additionalProperties": {"type": "boolean"}
            }
          ]
        },
        "parsers": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/check"}
        },
        "thresholds": {
          "type": "object",
          "properties": {
            "logging": {"$ref": "#/$defs/loggingThresholds"}
          }
        },
        "convergence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "retry_interval_seconds": {"type": "integer", "minimum": 1},
            "interval_seconds": {"type": "integer", "minimum": 1},
            "timeout_seconds": {"type": "integer", "minimum": 1},
            "stable_success_count": {"type": "integer", "minimum": 1},
            "consecutive_passes": {"type": "integer", "minimum": 1}
          }
        },
        "operation_gate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "interactive_action": {"enum": ["confirm", "abort"]},
            "non_interactive_action": {"const": "abort"}
          }
        },
        "report": {"type": "object"}
      }
    }
  },
  "$defs": {
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "command", "required"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "command": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"},
              "when": {"type": ["string", "object"]}
            }
          }
        }
      }
    },
    "loggingThresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity_threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "lookback_seconds": {"type": "integer", "minimum": 0},
        "time_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["all", "days", "start-time"]},
            "days": {"type": "integer", "minimum": 1},
            "start_time": {"type": "string", "format": "date-time"}
          },
          "oneOf": [
            {
              "properties": {"mode": {"const": "all"}},
              "not": {
                "anyOf": [
                  {"required": ["days"]},
                  {"required": ["start_time"]}
                ]
              }
            },
            {
              "properties": {"mode": {"const": "days"}},
              "required": ["days"],
              "not": {"required": ["start_time"]}
            },
            {
              "properties": {"mode": {"const": "start-time"}},
              "required": ["start_time"],
              "not": {"required": ["days"]}
            }
          ]
        },
        "include_patterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "exclude_patterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evaluator", "severity"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "evaluator": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "warn", "fail"]},
        "applicable_when": {"type": ["string", "object"]},
        "comparison": {"type": ["string", "object"]},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
