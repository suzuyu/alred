{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alred.local/schemas/v1/health-phase-attempt.schema.json",
  "title": "HealthPhaseAttempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_id", "phase", "attempt_id", "status", "started_at", "artifact_dir"],
  "properties": {
    "schema_version": {"const": 1},
    "change_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["before", "rollback"]},
    "attempt_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["RUNNING", "COMPLETED", "FAILED"]},
    "health_result": {"enum": ["PASS", "WARN", "FAIL", "UNKNOWN"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "artifact_dir": {"type": "string", "minLength": 1},
    "profile_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profile_revision": {"type": "string", "minLength": 1},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
