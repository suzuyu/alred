{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alred.local/schemas/v1/health-snapshot.schema.json",
  "title": "HealthSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "collection_id",
    "phase",
    "profile_sha256",
    "hosts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "change_id": {"type": "string", "minLength": 1},
    "collection_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["before", "after", "rollback"]},
    "created_at": {"type": "string", "format": "date-time"},
    "timezone": {"type": "string", "minLength": 1},
    "parser_versions": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "link_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalizer_version",
        "builder_version",
        "policy_hashes",
        "host_map",
        "source_status",
        "confirmed_links",
        "candidate_links",
        "diagnostics"
      ],
      "properties": {
        "normalizer_version": {"type": "string", "minLength": 1},
        "builder_version": {"type": "string", "minLength": 1},
        "policy_hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mappings", "description_rules"],
          "properties": {
            "mappings": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "description_rules": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "host_map": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "source_status": {"type": "object"},
        "health_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eligible_hosts", "excluded_hosts"],
          "properties": {
            "eligible_hosts": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "excluded_hosts": {
              "type": "object",
              "additionalProperties": {"type": "string", "minLength": 1}
            }
          }
        },
        "confirmed_links": {
          "type": "array",
          "items": {"type": "object"}
        },
        "candidate_links": {
          "type": "array",
          "items": {"type": "object"}
        },
        "diagnostics": {"type": "object"}
      }
    },
    "hosts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["common", "profiles", "sources"],
        "properties": {
          "address": {"type": "string", "format": "ip-address"},
          "platform": {"type": "string", "minLength": 1},
          "collection_status": {
            "enum": ["success", "partial", "failed"]
          },
          "common": {"type": "object"},
          "profiles": {"type": "object"},
          "sources": {"type": "object"},
          "parse_warnings": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
