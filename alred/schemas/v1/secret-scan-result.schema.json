{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alred.local/schemas/v1/secret-scan-result.schema.json",
  "title": "SecretScanResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "spec"],
  "properties": {
    "api_version": {"const": "alred/v1"},
    "kind": {"const": "SecretScanResult"},
    "spec": {"$ref": "#/$defs/result"}
  },
  "$defs": {
    "location": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["line"],
          "properties": {"line": {"type": "integer", "minimum": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_line", "end_line"],
          "properties": {
            "start_line": {"type": "integer", "minimum": 1},
            "end_line": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "confidence", "artifact_id", "path", "location", "count"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "confidence": {"enum": ["high", "low"]},
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "location": {"$ref": "#/$defs/location"},
        "count": {"type": "integer", "minimum": 1}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_version", "catalog_sha256", "status", "files_scanned",
        "files_not_scanned", "high_confidence", "low_confidence", "findings"
      ],
      "properties": {
        "catalog_version": {"const": 1},
        "catalog_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "status": {
          "enum": [
            "CLEAN", "LOW_CONFIDENCE_FINDINGS", "BLOCKED",
            "ACKNOWLEDGED_SENSITIVE", "NOT_SCANNED"
          ]
        },
        "files_scanned": {"type": "integer", "minimum": 0},
        "files_not_scanned": {"type": "integer", "minimum": 0},
        "high_confidence": {"type": "integer", "minimum": 0},
        "low_confidence": {"type": "integer", "minimum": 0},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    }
  }
}
