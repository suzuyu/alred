{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alred.local/schemas/v1/overlay-change-set.schema.json",
  "title": "OverlayChangeSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "alred/v1"},
    "kind": {"const": "OverlayChangeSet"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_id", "source"],
      "properties": {
        "change_id": {"type": "string", "minLength": 1},
        "source": {"enum": ["discovered", "declared", "generated", "imported"]},
        "generated_at": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l2vnis", "l3vnis"],
      "oneOf": [
        {
          "required": ["device_groups"],
          "not": {"required": ["device_groups_ref"]}
        },
        {
          "required": ["device_groups_ref"],
          "not": {"required": ["device_groups"]}
        }
      ],
      "properties": {
        "device_groups": {
          "type": "object",
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/device_group"}
        },
        "device_groups_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/).+"
            }
          }
        },
        "l2vnis": {
          "type": "array",
          "items": {"$ref": "#/$defs/l2vni"}
        },
        "l3vnis": {
          "type": "array",
          "items": {"$ref": "#/$defs/l3vni"}
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery", "observed", "conflicts", "warnings"],
      "properties": {
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before_snapshot", "after_snapshot", "confidence"],
          "properties": {
            "before_snapshot": {"type": "string", "minLength": 1},
            "after_snapshot": {"type": "string", "minLength": 1},
            "confidence": {"enum": ["high", "medium", "low"]}
          }
        },
        "observed": {"type": "array", "items": {"type": "object"}},
        "conflicts": {"type": "array", "items": {"type": "object"}},
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason", "message"],
            "properties": {
              "reason": {"type": "string", "minLength": 1},
              "message": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "device_group": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {"required": ["devices"]},
        {"required": ["groups"]}
      ],
      "properties": {
        "devices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "target_override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vlan": {"type": "integer", "minimum": 1, "maximum": 4094},
        "svi": {"const": false}
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "groups": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/target_override"}
        },
        "devices": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/target_override"}
        }
      }
    },
    "svi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mtu": {"type": "integer", "minimum": 576, "maximum": 9216},
        "ipv4_addresses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "ipv6_addresses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "ipv6_link_local": {"type": "string", "minLength": 1},
        "ipv6_nd_suppress_ra": {"type": "boolean"},
        "gateway_mode": {"enum": ["anycast"]}
      },
      "anyOf": [
        {"required": ["ipv4_addresses"]},
        {"required": ["ipv6_addresses"]}
      ]
    },
    "l2vni": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vni", "targets"],
      "properties": {
        "vni": {"type": "integer", "minimum": 1, "maximum": 16777215},
        "default_vlan": {"type": "integer", "minimum": 1, "maximum": 4094},
        "vlan_name": {"type": "string", "minLength": 1},
        "vrf": {"type": "string", "minLength": 1},
        "l3vni": {"type": "integer", "minimum": 1, "maximum": 16777215},
        "svi": {"$ref": "#/$defs/svi"},
        "targets": {"$ref": "#/$defs/targets"}
      }
    },
    "l3vni": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vni", "vrf", "targets"],
      "properties": {
        "vni": {"type": "integer", "minimum": 1, "maximum": 16777215},
        "vrf": {"type": "string", "minLength": 1},
        "mode": {"enum": ["new_l3vni", "traditional_vlan_svi"]},
        "default_vlan": {"type": "integer", "minimum": 1, "maximum": 4094},
        "svi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mtu": {"type": "integer", "minimum": 576, "maximum": 9216}
          }
        },
        "address_families": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "ipv4": {"$ref": "#/$defs/address_family"},
            "ipv6": {"$ref": "#/$defs/address_family"}
          }
        },
        "targets": {"$ref": "#/$defs/targets"}
      }
    },
    "redistribute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "route_map": {"type": "string", "minLength": 1}
      }
    },
    "address_family": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "advertise_l2vpn_evpn": {"type": "boolean"},
        "redistribute_direct": {"$ref": "#/$defs/redistribute"},
        "redistribute_static": {"$ref": "#/$defs/redistribute"},
        "maximum_paths_ibgp": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    }
  }
}
