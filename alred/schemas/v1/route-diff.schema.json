{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alred:v1:route-diff",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "RouteDiff"
    },
    "versions": {
      "type": "object",
      "properties": {
        "terminal_adapter": {
          "type": "string",
          "minLength": 1
        },
        "parser": {
          "type": "string",
          "minLength": 1
        },
        "normalizer": {
          "type": "string",
          "minLength": 1
        },
        "comparator": {
          "type": "string",
          "minLength": 1
        },
        "evaluator": {
          "type": "string",
          "minLength": 1
        },
        "renderer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "terminal_adapter",
        "parser",
        "normalizer",
        "comparator",
        "evaluator",
        "renderer"
      ],
      "additionalProperties": true
    },
    "snapshot_ids": {
      "type": "object",
      "properties": {
        "before": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "after": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "additionalProperties": true
    },
    "comparison_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "comparison": {
      "type": "object",
      "properties": {
        "primary_mode": {
          "enum": [
            "route-only",
            "route-ad",
            "route-ad-cost",
            "nexthop-include",
            "route-ad-cost-nexthop"
          ]
        },
        "modes": {
          "type": "array",
          "items": {
            "enum": [
              "route-only",
              "route-ad",
              "route-ad-cost",
              "nexthop-include",
              "route-ad-cost-nexthop"
            ]
          }
        },
        "selected_scopes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "device": {
                "type": "string",
                "minLength": 1
              },
              "vrf": {
                "type": "string",
                "minLength": 1
              },
              "family": {
                "enum": [
                  "ipv4",
                  "ipv6"
                ]
              }
            },
            "required": [
              "device",
              "vrf",
              "family"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "primary_mode",
        "modes",
        "selected_scopes"
      ],
      "additionalProperties": true
    },
    "policy": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Source"
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "coverage": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNKNOWN"
          ]
        },
        "complete_scope_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_scope_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_source_count": {
          "type": "integer",
          "minimum": 0
        },
        "modes": {
          "type": "object",
          "properties": {
            "route-only": {
              "$ref": "#/$defs/Counts"
            },
            "route-ad": {
              "$ref": "#/$defs/Counts"
            },
            "route-ad-cost": {
              "$ref": "#/$defs/Counts"
            },
            "nexthop-include": {
              "$ref": "#/$defs/Counts"
            },
            "route-ad-cost-nexthop": {
              "$ref": "#/$defs/Counts"
            }
          },
          "required": [
            "route-only",
            "route-ad",
            "route-ad-cost",
            "nexthop-include",
            "route-ad-cost-nexthop"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "coverage",
        "complete_scope_count",
        "unknown_scope_count",
        "unknown_source_count",
        "modes"
      ],
      "additionalProperties": true
    },
    "scopes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ComparisonScope"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entry"
      }
    },
    "policy_results": {
      "type": "object",
      "properties": {
        "required_routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequiredDecision"
          }
        },
        "expected_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExpectedDecision"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExclusionDecision"
          }
        },
        "general_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GeneralDecision"
          }
        }
      },
      "required": [
        "required_routes",
        "expected_changes",
        "exclusions",
        "general_changes"
      ],
      "additionalProperties": true
    },
    "evaluation": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "UNKNOWN",
        "EXCLUDED",
        "NOT_EVALUATED"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        1,
        3,
        4
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "versions",
    "snapshot_ids",
    "comparison_fingerprint",
    "comparison",
    "policy",
    "policy_sha256",
    "sources",
    "summary",
    "scopes",
    "entries",
    "policy_results",
    "evaluation",
    "exit_code",
    "diagnostics"
  ],
  "additionalProperties": true,
  "$defs": {
    "Evidence": {
