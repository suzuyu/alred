        "asymmetric": {
          "enum": [
            null,
            true
          ]
        }
      },
      "required": [
        "kind",
        "next_hop_family",
        "address",
        "interface",
        "next_hop_vrf",
        "admin_distance",
        "metric",
        "evidence",
        "next_hop_table_family",
