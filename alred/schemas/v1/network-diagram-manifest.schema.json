{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alred.local/schemas/v1/network-diagram-manifest.schema.json",
  "title": "NetworkDiagramManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "spec"],
  "properties": {
    "api_version": {"const": "alred/v1"},
    "kind": {"const": "NetworkDiagramManifest"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "options", "inputs", "artifacts"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "enum": ["evidence-package", "running-config-import", "latest-operation", "operation", "file"]
            },
            "value": {"type": "string", "minLength": 1}
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_confidence", "direction", "group_by_role", "group_by_site", "all_graph"],
          "properties": {
            "min_confidence": {"enum": ["low", "medium", "high"]},
            "direction": {"enum": ["TD", "LR", "BT", "RL"]},
            "group_by_role": {"type": "boolean"},
            "group_by_site": {"type": "boolean"},
            "all_graph": {"type": "boolean"},
            "defined_roles_only_page": {"type": "boolean"},
            "views": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["physical", "underlay", "evpn", "overlay-service"]}
            },
            "overlay_service": {"type": "boolean"},
            "overlay_detail_limit": {"type": "integer", "minimum": 0},
            "all_overlay_details": {"type": "boolean"},
            "overlay_detail_formats": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["markdown", "drawio"]}
            },
            "overlay_selectors": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sites", "vrfs", "l2vnis", "l3vnis", "services"],
              "properties": {
                "sites": {"type": "array", "items": {"type": "string"}},
                "vrfs": {"type": "array", "items": {"type": "string"}},
                "l2vnis": {"type": "array", "items": {"type": "integer", "minimum": 1}},
                "l3vnis": {"type": "array", "items": {"type": "integer", "minimum": 1}},
                "services": {"type": "array", "items": {"type": "string"}}
              }
            },
            "overlay_detail_selection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["generated_service_ids", "omitted_service_ids"],
              "properties": {
                "generated_service_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                "omitted_service_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
              }
            },
            "drawio_directions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["TD", "LR", "BT", "RL"]}
            },
            "link_diagnostics": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evaluation_status", "result", "diagnostic_count", "unevaluated_claim_count", "affected_device_count"],
              "properties": {
                "evaluation_status": {"enum": ["complete", "partial", "not-evaluated"]},
                "result": {"enum": ["pass", "warning", "conflict", "unknown"]},
                "diagnostic_count": {"type": "integer", "minimum": 0},
                "unevaluated_claim_count": {"type": "integer", "minimum": 0},
                "affected_device_count": {"type": "integer", "minimum": 0}
              }
            }
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/file"}
        },
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/file"}
        }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
